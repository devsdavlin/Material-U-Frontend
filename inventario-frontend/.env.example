# URL base del backend para frontend en desarrollo y producción.
# En Vercel, define esta variable en Production, Preview y Development.
# IMPORTANTE: no incluyas una barra final, y no la dejes vacía.
VITE_API_URL=https://material-u-backend.onrender.com/api

# Ejemplo para desarrollo local si usas un backend distinto:
# VITE_API_URL=http://localhost:4000/api
VITE_ENABLE_MOCKS=false

